# Configurações do Tribunal Superior Eleitoral (TSE)
TSE_BASE_URL=https://resultados.tse.jus.br
TSE_POLL_INTERVAL=15000
TSE_CACHE_TTL=10000

# Parâmetros de Eleição e Localidade
# Santa Maria / RN (Código TSE: 16241, IBGE: 2409335, UF: RN)
TSE_ELECTION_CYCLE=ele2026
TSE_UF=rn
TSE_CITY_CODE=16241
TSE_IBGE_CODE=2409335

# Eleições 2026 1º Turno (Pleito 3220)
# Federal: 6257 (Presidente)
# Estadual: 6259 (Governador, Senador, Deputado Federal, Deputado Estadual)
TSE_ELECTION_FEDERAL=6257
TSE_ELECTION_ESTADUAL=6259

# Redes Sociais / Calangos Marketing
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/calangosmarketing
